# Usa la URL del "Session pooler" (puerto 5432). La del modo transacción (6543) no sirve.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Puede ser la misma base de desarrollo: cada prueba revierte lo que inserta.
TEST_DATABASE_URL=

API_PORT=3000
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000
# M5: límite propio para el ruteo y cuántas rutas se calculan a la vez (el resto espera en cola).
ROUTING_STATEMENT_TIMEOUT_MS=3000
ROUTING_CONCURRENCY=4
# Más que esto esperando y el ruteo responde 503 enseguida en vez de encolar sin fin.
ROUTING_MAX_QUEUE=30
# true solo si el API está detrás de un proxy propio que agrega X-Forwarded-For (el de Vite lo
# hace en desarrollo). Así el tope por IP ve la IP del cliente y no la del proxy.
TRUST_PROXY=false
