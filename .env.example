# Supabase → Project Settings → Database → Connection string → "Session pooler" (puerto 5432).
# El modo transacción (6543) no sirve: pierde statement_timeout entre consultas.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Base para pruebas de integración. Puede ser la misma de desarrollo: cada prueba revierte su transacción.
TEST_DATABASE_URL=

API_PORT=3000
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=5000
