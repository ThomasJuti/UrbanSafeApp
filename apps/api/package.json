{
  "name": "@urbansafe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/app/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/app/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/app/run-seeds.ts",
    "db:import-graph": "tsx --env-file-if-exists=../../.env src/app/import-road-graph.ts",
    "db:import-base-risk": "tsx --env-file-if-exists=../../.env src/app/import-base-risk.ts",
    "db:import-safe-places": "tsx --env-file-if-exists=../../.env src/app/import-safe-places.ts",
    "load:routes": "tsx src/app/load-test-routes.ts",
    "load:delivery": "tsx src/app/load-test-delivery.ts",
    "load:demo": "tsx src/app/load-test-demo.ts",
    "measure:safe-route": "tsx src/app/measure-safe-route.ts",
    "measure:alphas": "tsx --env-file-if-exists=../../.env src/app/measure-safe-alphas.ts",
    "ingest:news": "tsx --env-file-if-exists=../../.env src/app/ingest-news.ts",
    "ingest:sample": "tsx --env-file-if-exists=../../.env src/app/ingest-news.ts --sample"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@urbansafe/shared": "workspace:*",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
